@@@ FIND
        var po = Number(p.vmax_vb_x).toFixed(1) + " / " + Number(p.vmax_vb_y).toFixed(1);
@@@ REPLACE
        // per direction: the index's own text (">= 5.3", "under review") when present, else the number
        var pv = function(d, w){
          var txt = p[(w ? "vmax_w_text_" : "vmax_vb_text_") + d], num = p[(w ? "vmax_w_" : "vmax_vb_") + d];
          var rev = p["under_review_" + d], tip = rev ? (p["review_" + d] || "under review")
                  : (p["vmax_lower_bound_" + d] ? (p.vmax_lower_bound_note || "lower bound") : "");
          if(p["mce_target_reached_" + d] === false && p["mce_target_text_" + d]) tip = (tip ? tip + " " : "") + p["mce_target_text_" + d];
          var shown = txt != null ? esc(txt) : (p["vmax_lower_bound_" + d] ? "&ge;&#8239;" : "") + Number(num).toFixed(w ? 2 : 1);
          return '<span' + (tip ? ' title="' + esc(tip) + '"' : "") + (rev ? ' class="muted"' : "") + ">" + shown + "</span>";
        };
        var w = p.headline === "vmax_w";
        var po = '<span class="nw">' + pv("x", w) + " / " + pv("y", w) + '</span><br><span class="muted nw"' +
                 (w ? ' title="' + esc((p.shed_basis || "") + (p.vmax_vb_note ? "; " + p.vmax_vb_note : "")) + '">V<sub>max</sub>/W' : ">V<sub>max</sub>/V<sub>B</sub>") + "</span>";
@@@ END

@@@ FIND
        <p class="muted exnote">V<sub>max</sub>/V<sub>B</sub> = peak pushover base shear / IS&nbsp;1893 design base shear, per direction.
           NLRHA: the largest storey drift of the 11-record mean, at DBE and MCE, with the records that converged;
@@@ REPLACE
        <p class="muted exnote">Pushover: V<sub>max</sub>/V<sub>B</sub> = peak base shear / IS&nbsp;1893 design base shear, per
           direction. On sheds and other single-storey or industrial buildings V<sub>B</sub> (R-reduced) is small, so the headline
           there is V<sub>max</sub>/W, the peak base shear over the seismic weight. &ge; marks a lower bound: that pushover
           stopped numerically before the curve reached its peak. &ldquo;Under review&rdquo; marks a pushover direction whose
           curve is not physically credible as it stands (hover for why); its values are not to be relied on until the cause
           is found.
           NLRHA: the largest storey drift of the mean over 11 record pairs (two horizontal components each) from the FEMA
           P-695 far-field set, at DBE and MCE, with the pairs that converged. The set holds no Indian or Himalayan records,
           so near-field and long-duration effects of Indian earthquakes are not represented;
@@@ END
